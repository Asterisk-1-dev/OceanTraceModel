# =======================================================
# OceanTrace: Root .gitignore
# =======================================================

# Python bytecode & test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.*
!.env.example
*.env

# Node / Frontend Dependencies & Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
.vite/

# Operating System & IDE / Editor Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.bak

# Temporary & Log Files
logs/
*.log
*.tmp
*.temp

# Large Datasets & Archives
data/*
!data/ais_scenarios/
*.zip
*.tar
*.tar.gz
*.7z
__MACOSX/

# Model Checkpoints (Ignore intermediate weights, keep frozen V6 E21 checkpoint)
*.pth
*.pt
*.onnx
!V6_E21_FINAL/oceantrace_v6_E21_final.pth

# Local Development & AI Agent Documentation
.ai/
.agents/
